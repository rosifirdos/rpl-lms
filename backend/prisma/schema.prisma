// =============================================================================
// SPADA LMS — Prisma Schema (MVP 1)
//
// Mengacu IMPLEMENTATION_PLAN_MVP1_BACKEND.md Bab 3 & SRS.md Bab 13.
//
// Keputusan 1 (BR-001): Standalone LMS — tidak ada SIA/PMB/KRS manual.
// Keputusan 2: 3 Role tunggal (mahasiswa, dosen, admin) sebagai enum.
// Keputusan 3 (BR-002): Direct Enrollment mahasiswa oleh Admin.
// Keputusan 4 (BR-009): Penyimpanan berkas terproteksi (private storage).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum UserRole {
  mahasiswa
  dosen
  admin
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Semester {
  ganjil
  genap
}

// ---------------------------------------------------------------------------
// Core — User, Profile, Mahasiswa, Dosen
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  username      String     @unique @db.VarChar(50)
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  profile        Profile?
  mahasiswa      Mahasiswa?
  dosen          Dosen?
  refresh_tokens RefreshToken[]
  audit_logs     AuditLog[]
  uploaded_files File[]

  @@map("users")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  full_name      String?  @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  bio            String?  @db.Text
  avatar_file_id String?  @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  user        User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  avatar_file File? @relation("ProfileAvatar", fields: [avatar_file_id], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Mahasiswa {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @unique @db.Uuid
  nim        String   @unique @db.VarChar(20)
  prodi      String   @db.VarChar(150)
  angkatan   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@map("mahasiswa")
}

model Dosen {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  nidn           String?  @unique @db.VarChar(20)
  nip            String?  @unique @db.VarChar(30)
  gelar_depan    String?  @db.VarChar(30)
  gelar_belakang String?  @db.VarChar(30)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  classes Class[]

  @@map("dosen")
}

// ---------------------------------------------------------------------------
// Auth — Refresh Token
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Master Akademik — Mata Kuliah, Kelas, Enrollment (BR-002)
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  credits     Int
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  classes Class[]

  @@map("courses")
}

model Class {
  id            String   @id @default(uuid()) @db.Uuid
  course_id     String   @db.Uuid
  lecturer_id   String   @db.Uuid
  academic_year String   @db.VarChar(10)
  semester      Semester
  name          String   @db.VarChar(50)
  capacity      Int      @default(40)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  course      Course       @relation(fields: [course_id], references: [id])
  lecturer    Dosen        @relation(fields: [lecturer_id], references: [id])
  enrollments Enrollment[]

  @@unique([course_id, academic_year, semester, name])
  @@index([academic_year, semester])
  @@index([lecturer_id])
  @@map("classes")
}

model Enrollment {
  id          String   @id @default(uuid()) @db.Uuid
  class_id    String   @db.Uuid
  student_id  String   @db.Uuid
  enrolled_by String   @db.Uuid
  enrolled_at DateTime @default(now())

  // Relations
  class   Class     @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student Mahasiswa @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@index([class_id])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// File Storage (Private — BR-009)
// ---------------------------------------------------------------------------

model File {
  id            String   @id @default(uuid()) @db.Uuid
  original_name String   @db.VarChar(255)
  storage_name  String   @unique @db.VarChar(255)
  file_path     String   @db.VarChar(500)
  mime_type     String   @db.VarChar(100)
  size_bytes    Int
  uploaded_by   String   @db.Uuid
  created_at    DateTime @default(now())

  // Relations
  uploader User      @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  profiles Profile[] @relation("ProfileAvatar")

  @@map("files")
}

// ---------------------------------------------------------------------------
// Audit Trail (NFR-009, FR-058)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(50)
  entity     String   @db.VarChar(50)
  entity_id  String?  @db.VarChar(255)
  old_values Json?
  new_values Json?
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  created_at DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id])
  @@map("audit_logs")
}
