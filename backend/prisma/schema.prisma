// =============================================================================
// E-Learning Kampus — Prisma Schema (MVP 1 + MVP 2 + MVP 3)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum UserRole {
  mahasiswa
  dosen
  admin
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Semester {
  ganjil
  genap
}

enum ExamType {
  NONE
  UTS
  UAS
}

enum AttendanceStatus {
  OPEN
  CLOSED
}

enum PresenceStatus {
  HADIR
  SAKIT
  IZIN
  ALPA
}

// ---------------------------------------------------------------------------
// Core — User, Profile, Mahasiswa, Dosen
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  username      String     @unique @db.VarChar(50)
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  profile                Profile?
  mahasiswa              Mahasiswa?
  dosen                  Dosen?
  refresh_tokens         RefreshToken[]
  password_reset_tokens  PasswordResetToken[]
  audit_logs             AuditLog[]
  uploaded_files         File[]
  config_updates         SystemConfig[] @relation("ConfigUpdater")
  notifications          Notification[]
  quiz_grades            QuizAttempt[]  @relation("QuizGrader")

  @@map("users")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  full_name      String?  @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  bio            String?  @db.Text
  avatar_file_id String?  @db.Uuid
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  user        User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  avatar_file File? @relation("ProfileAvatar", fields: [avatar_file_id], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Mahasiswa {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @unique @db.Uuid
  nim        String   @unique @db.VarChar(20)
  prodi      String   @db.VarChar(150)
  angkatan   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  attendance_records AttendanceRecord[]
  submissions        Submission[]
  quiz_attempts      QuizAttempt[]

  @@map("mahasiswa")
}

model Dosen {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  nidn           String?  @unique @db.VarChar(20)
  nip            String?  @unique @db.VarChar(30)
  gelar_depan    String?  @db.VarChar(30)
  gelar_belakang String?  @db.VarChar(30)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  classes Class[]

  @@map("dosen")
}

// ---------------------------------------------------------------------------
// Auth — Refresh Token & Reset Kata Sandi (FR-003)
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("refresh_tokens")
}

/**
 * Token pemulihan kata sandi (FR-003).
 *
 * Hanya hash SHA-256 dari token mentah yang disimpan; token mentah dikirim
 * eksklusif melalui email. Token bersifat sekali pakai (`used_at`) dan
 * kedaluwarsa (`expires_at`).
 */
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, used_at])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Master Akademik — Mata Kuliah, Kelas, Enrollment (BR-002)
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  credits     Int
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  classes Class[]

  @@map("courses")
}

model Class {
  id            String   @id @default(uuid()) @db.Uuid
  course_id     String   @db.Uuid
  lecturer_id   String   @db.Uuid
  academic_year String   @db.VarChar(10)
  semester      Semester
  name          String   @db.VarChar(50)
  capacity      Int      @default(40)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  course      Course       @relation(fields: [course_id], references: [id])
  lecturer    Dosen        @relation(fields: [lecturer_id], references: [id])
  enrollments Enrollment[]
  meetings    Meeting[]

  @@unique([course_id, academic_year, semester, name])
  @@index([academic_year, semester])
  @@index([lecturer_id])
  @@map("classes")
}

model Enrollment {
  id          String   @id @default(uuid()) @db.Uuid
  class_id    String   @db.Uuid
  student_id  String   @db.Uuid
  enrolled_by String   @db.Uuid
  enrolled_at DateTime @default(now())

  // Relations
  class   Class     @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student Mahasiswa @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@index([class_id])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// E-Learning MVP 2 — 16 Pertemuan, Materi, Presensi
// ---------------------------------------------------------------------------

model Meeting {
  id             String        @id @default(uuid()) @db.Uuid
  class_id       String        @db.Uuid
  meeting_number Int
  title          String        @db.VarChar(150)
  description    String?       @db.Text
  is_exam        Boolean       @default(false)
  exam_type      ExamType      @default(NONE)
  is_published   Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  class              Class              @relation(fields: [class_id], references: [id], onDelete: Cascade)
  materials          Material[]
  assignments        Assignment[]
  attendance_session AttendanceSession?
  scheduled_at       DateTime?
  quizzes            Quiz[]

  @@unique([class_id, meeting_number])
  @@map("meetings")
}

model Material {
  id          String   @id @default(uuid()) @db.Uuid
  meeting_id  String   @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  file_id     String   @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [file_id], references: [id], onDelete: Restrict)

  @@map("materials")
}

model AttendanceSession {
  id                String           @id @default(uuid()) @db.Uuid
  meeting_id        String           @unique @db.Uuid
  opened_at         DateTime?
  closed_at         DateTime?
  status            AttendanceStatus @default(CLOSED)
  tolerance_minutes Int              @default(15)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  meeting Meeting            @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                String         @id @default(uuid()) @db.Uuid
  session_id        String         @db.Uuid
  student_id        String         @db.Uuid
  status            PresenceStatus @default(HADIR)
  recorded_at       DateTime       @default(now())
  notes             String?        @db.Text
  is_auto_generated Boolean        @default(false)

  session AttendanceSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student Mahasiswa         @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// E-Learning MVP 3 — Tugas Perkuliahan, Submission, Penilaian
// ---------------------------------------------------------------------------

model Assignment {
  id                String   @id @default(uuid()) @db.Uuid
  meeting_id        String   @db.Uuid
  title             String   @db.VarChar(150)
  instructions      String?  @db.Text
  file_soal_id      String?  @db.Uuid // Berkas soal opsional
  weight_percentage Decimal  @db.Decimal(5, 2) // Bobot nilai 0.00–100.00
  due_date          DateTime // Deadline berbasis waktu server (BR-013)
  allow_late        Boolean  @default(false)
  is_published      Boolean  @default(true) // BR-005: draft tidak tampil ke mahasiswa
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  meeting     Meeting      @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  soal        File?        @relation("AssignmentSoal", fields: [file_soal_id], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([meeting_id])
  @@index([due_date])
  @@map("assignments")
}

model Submission {
  id            String    @id @default(uuid()) @db.Uuid
  assignment_id String    @db.Uuid
  student_id    String    @db.Uuid // Relasi ke Mahasiswa
  file_id       String    @db.Uuid // Berkas jawaban wajib ada
  submitted_at  DateTime  @default(now()) // Stempel waktu server
  is_late       Boolean   @default(false)
  score         Decimal?  @db.Decimal(5, 2) // 0.00–100.00, null = belum dinilai
  feedback      String?   @db.Text
  graded_at     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  assignment Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student    Mahasiswa  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  file       File       @relation("SubmissionFile", fields: [file_id], references: [id], onDelete: Restrict)

  @@unique([assignment_id, student_id])
  @@index([student_id])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// File Storage (Private — BR-009)
// ---------------------------------------------------------------------------

model File {
  id            String   @id @default(uuid()) @db.Uuid
  original_name String   @db.VarChar(255)
  storage_name  String   @unique @db.VarChar(255)
  file_path     String   @db.VarChar(500)
  mime_type     String   @db.VarChar(100)
  size_bytes    Int
  uploaded_by   String   @db.Uuid
  created_at    DateTime @default(now())

  // Relations
  uploader   User       @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  profiles   Profile[]  @relation("ProfileAvatar")
  materials  Material[]

  assignment_soal  Assignment[] @relation("AssignmentSoal")
  submission_files Submission[] @relation("SubmissionFile")

  @@map("files")
}

// ---------------------------------------------------------------------------
// Konfigurasi Sistem (FR-049, FR-050)
// ---------------------------------------------------------------------------

/**
 * Konfigurasi global sistem berbentuk key-value (FR-049, FR-050).
 *
 * Nilai disimpan sebagai JSON agar tipe fleksibel (array/number). Default
 * perilaku didefinisikan di `src/constants/config.js`; baris yang belum ada
 * berarti memakai default tersebut.
 */
model SystemConfig {
  key        String   @id @db.VarChar(60)
  value      Json
  updated_by String?  @db.Uuid
  updated_at DateTime @updatedAt

  // Relations
  updater User? @relation("ConfigUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("system_configs")
}

// ---------------------------------------------------------------------------
// Audit Trail (NFR-009, FR-058)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(50)
  entity     String   @db.VarChar(50)
  entity_id  String?  @db.VarChar(255)
  old_values Json?
  new_values Json?
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  created_at DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id])
  @@map("audit_logs")
}
// ---------------------------------------------------------------------------
// MVP 4 — Kuis Interaktif (FR-025, FR-040–FR-041)
// ---------------------------------------------------------------------------

enum QuizQuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// Kuis terikat pertemuan; terpisah dari Assignment (kuis bukan tugas).
model Quiz {
  id               String   @id @default(uuid()) @db.Uuid
  meeting_id       String   @db.Uuid
  title            String   @db.VarChar(150)
  instructions     String?  @db.Text
  duration_minutes Int
  open_at          DateTime
  close_at         DateTime
  is_published     Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relations
  meeting   Meeting       @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([meeting_id])
  @@index([open_at, close_at])
  @@map("quizzes")
}

/// Butir soal kuis; kunci jawaban tidak pernah dikirim ke mahasiswa.
model QuizQuestion {
  id            String           @id @default(uuid()) @db.Uuid
  quiz_id       String           @db.Uuid
  question_text String           @db.Text
  type          QuizQuestionType
  points        Decimal          @db.Decimal(5, 2) @default(1)
  answer_key    String?          @db.Text
  order_index   Int
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // Relations
  quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@unique([quiz_id, order_index])
  @@map("quiz_questions")
}

/// Opsi jawaban pilihan ganda; `is_correct` hanya untuk penilaian server.
model QuizOption {
  id          String  @id @default(uuid()) @db.Uuid
  question_id String  @db.Uuid
  option_text String  @db.VarChar(500)
  is_correct  Boolean @default(false)
  order_index Int

  // Relations
  question QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@unique([question_id, order_index])
  @@map("quiz_options")
}

/// Percobaan pengerjaan kuis — satu per mahasiswa per kuis.
model QuizAttempt {
  id           String            @id @default(uuid()) @db.Uuid
  quiz_id      String            @db.Uuid
  student_id   String            @db.Uuid
  started_at   DateTime          @default(now())
  deadline_at  DateTime
  submitted_at DateTime?
  status       QuizAttemptStatus @default(IN_PROGRESS)
  score        Decimal?          @db.Decimal(5, 2)
  graded_at    DateTime?
  graded_by    String?           @db.Uuid

  // Relations
  quiz     Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  student  Mahasiswa    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  grader   User?        @relation("QuizGrader", fields: [graded_by], references: [id], onDelete: SetNull)
  answers  QuizAnswer[]

  @@unique([quiz_id, student_id])
  @@index([student_id])
  @@map("quiz_attempts")
}

/// Jawaban mahasiswa per soal; pilihan ganda dinilai otomatis, esai manual.
model QuizAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  attempt_id         String   @db.Uuid
  question_id        String   @db.Uuid
  selected_option_id String?  @db.Uuid
  answer_text        String?  @db.Text
  points_awarded     Decimal? @db.Decimal(5, 2)
  feedback           String?  @db.Text
  updated_at         DateTime @updatedAt

  // Relations
  attempt         QuizAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question        QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_option QuizOption?  @relation(fields: [selected_option_id], references: [id], onDelete: SetNull)

  @@unique([attempt_id, question_id])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------------------
// MVP 4 — Notifikasi Internal (FR-057)
// ---------------------------------------------------------------------------

enum NotificationType {
  ASSIGNMENT_CREATED
  DEADLINE_REMINDER
  ATTENDANCE_OPENED
  ATTENDANCE_UPDATED
  GRADE_PUBLISHED
  ENROLLMENT_CREATED
  QUIZ_PUBLISHED
}

/// Notifikasi internal best-effort; dedupe via `dedupe_key` per pengguna.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(150)
  message    String           @db.Text
  link       String?          @db.VarChar(255)
  dedupe_key String?          @db.VarChar(150)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dedupe_key])
  @@index([user_id, is_read, created_at])
  @@map("notifications")
}
