PORT=5000
NODE_ENV=development

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rpl_lms?schema=public"

# Database terisolasi untuk pengujian otomatis (DoD B4 - test isolation).
# Opsional: bila dikosongkan, tests/setup.js menurunkan nilainya dari DATABASE_URL
# dengan mengganti nama database menjadi `rpl_review`.
# Database ini harus sudah dimigrasi + diseed sebelum `npm test` dijalankan.
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/rpl_review?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="super-secret-access-key-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-minimum-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# File Storage (BR-009 — private storage, di luar public web root)
# UPLOAD_DIR default: <project>/storage/private
# Avatar: .jpg/.jpeg/.png, maks 2MB (FR-007)
# Dokumen: .pdf/.docx/.xlsx/.zip, maks 10MB (BR-007)
# Batas berkas jawaban tugas: 5–10MB (FR-019, BR-008). Default 10.
# Nilai di luar rentang akan ditolak saat startup.
MAX_SUBMISSION_SIZE_MB="10"

# Email (FR-003 — reset kata sandi)
# Transport: smtp (produksi, wajib isi SMTP_HOST) | log (dev, tulis ke console) | memory (test)
# Pada NODE_ENV=test transport otomatis dipaksa "memory".
# PERHATIAN (R-02): pada NODE_ENV=production tanpa MAIL_TRANSPORT, default menjadi
# "smtp" dan startup GAGAL bila SMTP_HOST kosong. "log" hanya untuk development —
# memakainya di produksi akan mencetak isi email (termasuk tautan/token reset)
# utuh ke log dan selalu memunculkan peringatan eksplisit saat startup.
MAIL_TRANSPORT="log"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="no-reply@elearning.local"

# URL frontend untuk menyusun tautan (mis. tautan reset kata sandi)
FRONTEND_URL="http://localhost:5173"

# Umur token reset kata sandi dalam menit (5–120). Default 30.
PASSWORD_RESET_TTL_MINUTES="30"
