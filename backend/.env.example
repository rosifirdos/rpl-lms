PORT=5000
NODE_ENV=development

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rpl_lms?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="super-secret-access-key-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-minimum-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# File Storage (BR-009 — private storage, di luar public web root)
# UPLOAD_DIR default: <project>/storage/private
# Avatar: .jpg/.jpeg/.png, maks 2MB (FR-007)
# Dokumen: .pdf/.docx/.xlsx/.zip, maks 10MB (BR-007)
